{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "media-manager",
  "version": "0.1.0",
  "identifier": "com.example.media-manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "影视库", "width": 1100, "height": 720, "minWidth": 800, "minHeight": 560 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}